#!/usr/bin/env python3
"""AML triage entrypoint. Called as ./run <institution_folder> <output.jsonl> from any cwd."""

import json
import os
import sys
import time
import traceback

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import config

config.load_dotenv()

from analyze import classify_documents
from config import parse_policy, sanity_check_policy
from decide import decide
from explain import render
from facts import build_case
from loader import load_institution


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: ./run <institution_folder> <output.jsonl>\n")
        return 2
    folder = os.path.abspath(argv[1])
    out_path = os.path.abspath(argv[2])
    started = time.time()
    bundle = load_institution(folder)
    for note in sanity_check_policy(bundle["policy_text"]):
        sys.stderr.write("policy note: %s\n" % note)
    policy = parse_policy(bundle["policy_text"])
    parent = os.path.dirname(out_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    allow_model = _allow_model()
    counts = {}
    written = 0
    with open(out_path, "w", encoding="utf-8") as fh:
        for case in bundle["cases"]:
            row = _one(bundle, policy, case, allow_model)
            fh.write(json.dumps(row, ensure_ascii=False, sort_keys=False) + "\n")
            counts[row["verdict"]] = counts.get(row["verdict"], 0) + 1
            written += 1
    elapsed = time.time() - started
    sys.stderr.write(
        "wrote %d cases to %s in %.1fs %s\n" % (written, out_path, elapsed, json.dumps(counts, sort_keys=True))
    )
    return 0


def _allow_model():
    if os.environ.get("DISABLE_LLM") == "1":
        return False
    return bool(os.environ.get("XAI_API_KEY") or os.environ.get("OPENROUTER_API_KEY"))


def _one(bundle, policy, case, allow_model):
    try:
        built = build_case(bundle, policy, case, {})
        labels = classify_documents(built["docs"], allow_model)
        for doc in built["docs"]:
            doc["label"] = labels.get(doc["doc_id"], "")
        return render(built, decide(built))
    except Exception:
        sys.stderr.write("case %s failed\n%s\n" % (case.get("case_id"), traceback.format_exc()))
        return {
            "case_id": case.get("case_id"),
            "alert_ids": list(case.get("alert_ids") or []),
            "verdict": "ESCALATE",
            "reason_code": "ESC_UNEXPLAINED_FUNDS",
            "reason": (
                "This case could not be completed from the files. "
                "The activity is escalated because it is unexplained."
            ),
            "evidence": [],
        }


if __name__ == "__main__":
    sys.exit(main(sys.argv))
