#!/usr/bin/env python3
"""AML triage entrypoint. Called as ./run <institution_folder> <output.jsonl> from any cwd."""

import json
import os
import sys
import time

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import config

config.load_dotenv()

from analyze import STATS
from config import parse_policy, sanity_check_policy
from loader import load_institution
from pipeline import allow_model, iter_cases, worker_count


def main(argv):
    if len(argv) != 3:
        sys.stderr.write("usage: ./run <institution_folder> <output.jsonl>\n")
        return 2
    folder = os.path.abspath(argv[1])
    out_path = os.path.abspath(argv[2])
    started = time.time()
    bundle = load_institution(folder)
    for note in sanity_check_policy(bundle["policy_text"]):
        sys.stderr.write("policy note: %s\n" % note)
    policy = parse_policy(bundle["policy_text"])
    parent = os.path.dirname(out_path)
    if parent:
        os.makedirs(parent, exist_ok=True)
    enabled = allow_model()
    cases = bundle["cases"]
    limit = os.environ.get("CASE_LIMIT")
    if limit:
        cases = cases[: int(limit)]
    counts = {}
    written = 0
    with open(out_path, "w", encoding="utf-8", buffering=1) as fh:
        for line, _view in iter_cases(bundle, policy, cases, enabled, worker_count(enabled)):
            fh.write(json.dumps(line, ensure_ascii=False, sort_keys=False) + "\n")
            fh.flush()
            counts[line["verdict"]] = counts.get(line["verdict"], 0) + 1
            written += 1
    elapsed = time.time() - started
    sys.stderr.write(
        "wrote %d cases to %s in %.1fs %s agent_calls=%d agent_ok=%d\n"
        % (written, out_path, elapsed, json.dumps(counts, sort_keys=True), STATS["calls"], STATS["ok"])
    )
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
