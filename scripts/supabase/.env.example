# Copy to a local .env (gitignored) — never commit real values.
# Prefer the Database connection URI from Supabase Dashboard.

SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Alternatives:
# DATABASE_URL=
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_DB_PASSWORD=

# API keys alone are NOT enough for the Postgres loader:
# SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_JWKS_URL=
